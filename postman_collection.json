{
  "info": {
    "_postman_id": "b3e9a4f2-98e3-4f93-b6d4-8d48ef11b712",
    "name": "Inventory and Data Management System API",
    "description": "Postman collection for Web Dev III Unit 3 Assignment 3 - Inventory and Data Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 120,\n  \"quantity\": 40,\n  \"reorderLevel\": 20,\n  \"supplier\": \"Cello Pens\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"]
        },
        "description": "Add a new product with field-level validation and auto-computed stockValue."
      }
    },
    {
      "name": "2. Get All Products (Pagination & List)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products?page=1&limit=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        },
        "description": "View all products with total count, totalPages, and pagination metadata."
      }
    },
    {
      "name": "2a. Filter Products by Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products?category=Furniture",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "category", "value": "Furniture" }
          ]
        },
        "description": "Filter products belonging to a specific category."
      }
    },
    {
      "name": "2b. Search Products by Name",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products?search=Table",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "search", "value": "Table" }
          ]
        },
        "description": "Search products by name using case-insensitive regex."
      }
    },
    {
      "name": "2c. Filter by Price Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products?minPrice=1000&maxPrice=5000",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "minPrice", "value": "1000" },
            { "key": "maxPrice", "value": "5000" }
          ]
        },
        "description": "Filter products within a price range."
      }
    },
    {
      "name": "2d. Sort Products by Price / Quantity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products?sortBy=price&order=desc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "sortBy", "value": "price" },
            { "key": "order", "value": "desc" }
          ]
        },
        "description": "Sort products by price, name, or quantity."
      }
    },
    {
      "name": "3. Get Low-Stock Alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products/low-stock",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", "low-stock"]
        },
        "description": "Returns items where quantity is less than or equal to reorderLevel."
      }
    },
    {
      "name": "4. Category-wise Inventory Summary (Aggregation)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products/summary",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", "summary"]
        },
        "description": "Calculates category-wise total items, total quantity, total stock value, and average price using MongoDB aggregation pipeline."
      }
    },
    {
      "name": "5. Get Single Product by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", ":id"],
          "variable": [
            { "key": "id", "value": "REPLACE_WITH_VALID_ID" }
          ]
        },
        "description": "Retrieve product details by MongoDB ObjectId."
      }
    },
    {
      "name": "6. Update Product Details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 140,\n  \"quantity\": 60\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/products/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", ":id"],
          "variable": [
            { "key": "id", "value": "REPLACE_WITH_VALID_ID" }
          ]
        },
        "description": "Update product details and stock information."
      }
    },
    {
      "name": "7. Stock Adjustment (Restock or Sale)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"change\": 10\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/products/:id/stock",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", ":id", "stock"],
          "variable": [
            { "key": "id", "value": "REPLACE_WITH_VALID_ID" }
          ]
        },
        "description": "Increase or decrease stock safely, preventing negative stock."
      }
    },
    {
      "name": "8. Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", ":id"],
          "variable": [
            { "key": "id", "value": "REPLACE_WITH_VALID_ID" }
          ]
        },
        "description": "Delete a product by MongoDB ID."
      }
    }
  ]
}
